[Unit]
Description=Axiom Tempo proxy (Grafana Tempo API backed by Axiom APL)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=axiom-tempo-proxy
Group=axiom-tempo-proxy
EnvironmentFile=/etc/axiom-tempo-proxy/env
ExecStart=/usr/local/bin/axiom-tempo-proxy
Restart=always
RestartSec=3
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
